# 이 파일은 예시입니다. 실제 값을 채운 뒤 파일명을 .env 로 저장하세요.
# .env 파일 자체는 절대 git에 커밋하지 마세요.

# ---- JWT ----
JWT_SECRET=

# ---- Mail (SMTP) ----
MAIL_USERNAME=nextroom.official@gmail.com
MAIL_PASSWORD=

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---- AWS S3 ----
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=
AWS_S3_BUCKET=nextroom-image

# ---- Google IAP ----
IAP_GOOGLE_CREDENTIALS_PATH=nextroom-423b5-c373d4cf16bb.json

# ---- OAuth2 (Google) ----
OAUTH2_GOOGLE_CLIENT_ID=
OAUTH2_GOOGLE_CLIENT_SECRET=

# ---- Database (프로필별로 값이 다름: local / dev / prod) ----
DB_URL=jdbc:mysql://localhost:3306/nextroom
DB_USERNAME=
DB_PASSWORD=
