<?xml version="1.0" encoding="UTF-8" ?>
<configuration>

  <conversionRule conversionWord="clr" converterClass="org.springframework.boot.logging.logback.ColorConverter" />

  <property name="CONSOLE_LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %clr(%5level) %cyan(%logger) - %msg%n" />

  <!-- 컨테이너 환경에서는 stdout 으로만 출력한다(12-factor).
       수집/보존은 플랫폼이 담당: Docker json-file 로테이션(10m×3) → Alloy → Grafana Cloud Loki.
       (이전의 RollingFileAppender 는 /home/ubuntu/app/logs 라는 옛 EC2 경로에 기록해
        컨테이너 임시 레이어에 쌓였다가 배포 때마다 사라졌고, stdout 과 완전 중복이라 제거함) -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${CONSOLE_LOG_PATTERN}</pattern>
    </encoder>
  </appender>

  <springProfile name="local">
    <logger name="com.nextroom.nextRoomServer.*" level="DEBUG"/>
    <root level="INFO">
      <appender-ref ref="CONSOLE" />
    </root>
  </springProfile>

  <springProfile name="dev">
    <logger name="com.nextroom.nextRoomServer.*" level="DEBUG"/>
    <root level="INFO">
      <appender-ref ref="CONSOLE" />
    </root>
  </springProfile>

  <springProfile name="prod">
    <logger name="com.nextroom.nextRoomServer.*" level="DEBUG"/>
    <root level="INFO">
      <appender-ref ref="CONSOLE" />
    </root>
  </springProfile>

</configuration>
