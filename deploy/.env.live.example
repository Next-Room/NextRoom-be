# spring-live (prod 프로필) 환경변수 — deploy/.env.live 로 복사해 채우기
SERVER_PORT=8080

# DB (컨테이너 mysql, live 스키마)
DB_URL=jdbc:mysql://mysql:3306/nextroom_prod?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=nextroom
DB_PASSWORD=

# Redis (컨테이너 redis, live=DB index 0)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0

# JWT
JWT_SECRET=

# Mail (SMTP)
MAIL_USERNAME=nextroom.official@gmail.com
MAIL_PASSWORD=

# AWS S3 (유지)
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=
AWS_S3_BUCKET=nextroom-image

# Google IAP (컨테이너 내 마운트 경로 — 파일은 deploy/secrets 에 배치)
IAP_GOOGLE_CREDENTIALS_PATH=/app/config/iap-google-credentials.json

# OAuth2 (Google)
OAUTH2_GOOGLE_CLIENT_ID=
OAUTH2_GOOGLE_CLIENT_SECRET=
