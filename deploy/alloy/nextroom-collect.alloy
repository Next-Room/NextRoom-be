// NextRoom 수집 설정 — /etc/alloy/config.alloy 의 기본 블록(remote_write / loki.write)에 이어 붙인다.
// 기본 블록에는 Grafana Cloud 토큰이 있어 저장소에 두지 않는다.
// 참조하는 리시버(기본 블록에서 정의됨):
//   prometheus.remote_write.metrics_service.receiver
//   loki.write.grafana_cloud_loki.receiver

// ───────────── 호스트 메트릭 (node_exporter 내장) ─────────────
prometheus.exporter.unix "node" { }

discovery.relabel "node" {
  targets = prometheus.exporter.unix.node.targets

  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }
  // Linux Server 통합 대시보드가 이 job 라벨을 기대한다
  rule {
    target_label = "job"
    replacement  = "integrations/node_exporter"
  }
}

prometheus.scrape "node" {
  targets         = discovery.relabel.node.output
  forward_to      = [prometheus.remote_write.metrics_service.receiver]
  scrape_interval = "60s"
}

// ───────────── 시스템 로그 1: journald ─────────────
// unit 라벨을 붙여야 통합 대시보드에서 서비스별 필터가 동작한다
loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "hostname"
  }
}

loki.source.journal "journal" {
  // max_age 로 과거 백로그를 제한 → Loki "timestamp too old" 대량 거부 방지
  max_age       = "24h"
  relabel_rules = loki.relabel.journal.rules
  forward_to    = [loki.write.grafana_cloud_loki.receiver]
  labels        = {
    job      = "integrations/node_exporter",
    instance = constants.hostname,
  }
}

// ───────────── 시스템 로그 2: /var/log 파일 ─────────────
// Linux Server 통합의 "application logs" 검사가 이 스트림을 본다
local.file_match "system_logs" {
  path_targets = [{
    __address__ = "localhost",
    __path__    = "/var/log/{syslog,messages,*.log}",
    instance    = constants.hostname,
    job         = "integrations/node_exporter",
  }]
}

loki.source.file "system_logs" {
  targets    = local.file_match.system_logs.targets
  forward_to = [loki.write.grafana_cloud_loki.receiver]
}

// ───────────── 컨테이너 로그 (spring-live/dev, nginx, mysql, redis) ─────────────
// 요구사항: alloy 사용자가 docker 그룹에 속해야 /var/run/docker.sock 읽기 가능
discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "15s"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // "/nextroom-spring-live" → "nextroom-spring-live"
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }
  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }
  rule {
    target_label = "job"
    replacement  = "docker"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.write.grafana_cloud_loki.receiver]
}

// ───────────── 앱 메트릭 (Spring Actuator) ─────────────
// nginx 를 거치지 않고 docker 네트워크로 컨테이너를 직접 스크랩한다.
// (nginx 는 /actuator/prometheus 를 외부에 404 로 막아두었다)
discovery.relabel "spring_apps" {
  targets = discovery.docker.containers.targets

  // spring-live / spring-dev 만 대상
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/nextroom-spring-(live|dev)"
    action        = "keep"
  }
  // 컨테이너 IP:8080 으로 주소 지정 (재생성 시 IP 가 바뀌어도 자동 추적)
  rule {
    source_labels = ["__meta_docker_network_ip"]
    regex         = "(.+)"
    replacement   = "$1:8080"
    target_label  = "__address__"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }
  rule {
    target_label = "job"
    replacement  = "nextroom-spring"
  }
}

prometheus.scrape "spring_apps" {
  targets         = discovery.relabel.spring_apps.output
  forward_to      = [prometheus.remote_write.metrics_service.receiver]
  metrics_path    = "/actuator/prometheus"
  scrape_interval = "60s"
}

// ───────────── 컨테이너 리소스 메트릭 (cAdvisor) ─────────────
prometheus.exporter.cadvisor "containers" {
  docker_host      = "unix:///var/run/docker.sock"
  storage_duration = "5m"
}

discovery.relabel "cadvisor" {
  targets = prometheus.exporter.cadvisor.containers.targets

  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }
  rule {
    target_label = "job"
    replacement  = "integrations/docker"
  }
}

prometheus.scrape "cadvisor" {
  targets         = discovery.relabel.cadvisor.output
  forward_to      = [prometheus.relabel.cadvisor_filter.receiver]
  scrape_interval = "60s"
}

// cAdvisor 는 메트릭이 매우 많다. 무료 티어(10k active series) 보호를 위해
// 컨테이너 운영에 실제로 쓰는 지표만 남긴다.
prometheus.relabel "cadvisor_filter" {
  forward_to = [prometheus.remote_write.metrics_service.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "container_(cpu_usage_seconds_total|memory_working_set_bytes|memory_usage_bytes|network_(receive|transmit)_bytes_total|fs_usage_bytes|last_seen)"
    action        = "keep"
  }
}
